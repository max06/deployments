extra:
  - apiVersion: v1
    kind: Service
    metadata:
      name: external-traefik
      namespace: traefik
    spec:
      ports:
        - port: 80
          targetPort: 80
          name: http
        - port: 443
          targetPort: 443
          name: https

  - apiVersion: v1
    kind: Endpoints
    metadata:
      name: external-traefik
      namespace: traefik
    subsets:
      - addresses:
          - ip: 192.168.27.249 # Replace with your external Traefik's IP
        ports:
          - port: 80
            name: http
          - port: 443
            name: https

  - apiVersion: traefik.io/v1alpha1
    kind: ServersTransport
    metadata:
      name: insecure
      namespace: traefik
    spec:
      insecureSkipVerify: true

  - apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      name: catch-all-fallback
      namespace: traefik
    spec:
      entryPoints:
        - websecure
        - webinternal
      routes:
        - match: PathPrefix(`/`)
          kind: Rule
          priority: 1
          services:
            - name: external-traefik
              port: 443
              scheme: https # Forward as HTTPS
              passHostHeader: true
              serversTransport: insecure

  - apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      name: minio
      namespace: traefik
    spec:
      entryPoints:
        - websecure
        - webinternal
      routes:
        - match: Host(`s3.{{ .Values.primary_domain }}`)
          kind: Rule
          services:
            - name: syno
              port: 9000
              passHostHeader: true

  - apiVersion: v1
    kind: Service
    metadata:
      name: syno
      namespace: traefik
    spec:
      ports:
        - port: 9000
          targetPort: 9000
          name: http

  - apiVersion: v1
    kind: Endpoints
    metadata:
      name: syno
      namespace: traefik
    subsets:
      - addresses:
          - ip: 192.168.27.10
        ports:
          - port: 9000
            name: http


    # Matrix well-known delegation via redirect — no pod, no plugin.
    # Replace example.net with your domain.
    #
    # Synapse side (homeserver.yaml):
    #   public_baseurl: "https://matrix.example.net/"
    #   serve_server_wellknown: true
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: matrix-wellknown-redirect
      namespace: traefik
    spec:
      redirectRegex:
        regex: '^https://{{ .Values.primary_domain | replace "." "\\." }}/\.well-known/matrix/(.*)'
        replacement: 'https://matrix.{{ .Values.primary_domain }}/.well-known/matrix/${1}'
        # 302, deliberately: permanent redirects get cached by intermediaries,
        # which makes future delegation changes unpleasant to roll out.
        permanent: false
  - apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      name: matrix-wellknown
      namespace: traefik
    spec:
      entryPoints:
        - websecure
        - webinternal
      routes:
        - kind: Rule
          match: Host(`{{ .Values.primary_domain }}`) && PathPrefix(`/.well-known/matrix`)
          middlewares:
            - name: matrix-wellknown-redirect
          services:
            - name: noop@internal
              kind: TraefikService
      # no tls block needed: your default cert covers the apex SAN
