# DeepSeek Harness (dsh) — single-user agent harness with a web UI.
#
# Upstream ships no container or chart; this uses the community chart from
# runzhliu/deepseek-harness-docker, pulled straight from git at a release tag.
# Pin the git ref and image.tag together — the chart's appVersion tracks the
# image, and upstream warns about compatibility-breaking changes between
# pre-releases.
#
# Access model: the community image binds 0.0.0.0 inside the pod but expects
# a trusted boundary in front. We provide that boundary with traefik's
# webinternal entrypoint (LAN-only ipAllowList middleware). Only the web UI
# port is routed; the embedded noVNC desktop (6080) has no authentication and
# stays reachable via `kubectl port-forward` only.
#
# First login: the web UI issues a per-process launch token. Grab the URL from
#   kubectl -n dsh logs sts/dsh | grep 'dsh web:'
# and swap the 127.0.0.1:3080 part for https://dsh.<primary_domain>.
#
# Tool sandbox: dsh confines agent shell/file tools with Landlock, so the node
# kernel must have Landlock in its *active* LSM list (check
# /sys/kernel/security/lsm on the node, enable via `lsm=...,landlock` on the
# kernel cmdline if missing). The community bubblewrap image variant
# (`-bwrap.N` tags) is a Docker-Compose-only fallback for kernels without
# Landlock and needs seccomp/procMount relaxations — not used here.
#
# Provider credentials are optional at deploy time (they can be entered in the
# web UI settings). To ship them via SOPS instead, set `deepseek_api_key` in a
# values.sops.yaml next to the deployment — a Secret is then created and wired
# into the pod as an environment variable.

repositories:
  - name: bedag
    url: https://bedag.github.io/helm-charts/

releases:
  # Ingress, workspace PVC and optional credentials Secret. Listed first so
  # the PVC and Secret exist before the StatefulSet pod references them.
  - name: dsh-extras
    namespace: dsh
    chart: bedag/raw
    version: 2.0.2
    values:
      - extras.yaml.gotmpl

  - name: dsh
    namespace: dsh
    chart: git::https://github.com/runzhliu/deepseek-harness-docker.git@charts/deepseek-harness?ref=image-v0.2.2-rc.1-r1
    values:
      - image:
          repository: ghcr.io/runzhliu/deepseek-harness
          # `-bwrap.1` variant: the base image plus bubblewrap. dsh's tool
          # sandbox fails closed unless it finds bwrap or a Landlock-enforcing
          # kernel, and the Raspberry Pi kernels on picon are built without
          # CONFIG_SECURITY_LANDLOCK (checked up to 6.18.60+rpt), so bwrap is
          # the only backend available. See the sandbox block below.
          tag: 0.2.2-rc.1-r1-bwrap.1

        # Stable resource names regardless of how the release name is derived,
        # so extras.yaml.gotmpl can target the Service and Secret by name.
        fullnameOverride: dsh

        # dsh state (profiles, settings, credentials, sessions).
        persistence:
          size: 5Gi

        # Agent working directory. The chart only mounts an emptyDir here
        # unless given a claim, so uncommitted work would vanish on every
        # reschedule. The PVC is created in extras.yaml.gotmpl.
        workspace:
          existingClaim: dsh-workspace

        # The chart defaults to deny-all ingress (port-forward only). Open
        # exactly one hole: traefik pods → the web UI port. noVNC stays closed.
        networkPolicy:
          enabled: true
          ingress:
            - from:
                - namespaceSelector:
                    matchLabels:
                      kubernetes.io/metadata.name: traefik
              ports:
                - port: http
                  protocol: TCP

        credentials:
          existingSecret: '{{ if .Values | getOrNil "deepseek_api_key" }}dsh-credentials{{ end }}'

        # Container args. Restates the chart default (web + community patch +
        # --no-open) because the list replaces wholesale, then adds the
        # authority we serve on. Upstream fences every /api request (REST and
        # the /api/remote.mux websocket) behind a Host/Origin allowlist that
        # only admits loopback by default; without --trusted-host the UI loads
        # but the websocket upgrade is refused and the app never connects.
        args:
          - web
          - --patch
          - /opt/deepseek-harness/web.cordis.patch.yml
          - --no-open
          - --trusted-host
          - "dsh.{{ .Values.primary_domain }}"

        resources:
          requests:
            cpu: 250m
            memory: 1Gi
          limits:
            memory: 4Gi

        # bwrap sandbox, Kubernetes equivalent of upstream's compose.bwrap.yaml
        # (`seccomp=unconfined` + `systempaths=unconfined`). bwrap needs to
        # create a user + PID namespace and mount a fresh /proc inside the pod:
        #   - seccomp Unconfined: RuntimeDefault blocks unshare(CLONE_NEWUSER)
        #     for processes without CAP_SYS_ADMIN.
        #   - procMount Unmasked: the runtime's masked /proc paths make the
        #     kernel refuse the nested proc mount.
        # Both were verified as individually required on picon. They are only
        # acceptable together with `hostUsers: false` (patch below): the pod
        # then runs in its own user namespace, so container uid 0/1000 map to
        # an unprivileged host uid range. Non-root, no capabilities,
        # no-new-privileges and the read-only root filesystem stay as the
        # chart sets them (maps merge, only the listed keys change).
        podSecurityContext:
          seccompProfile:
            type: Unconfined
        securityContext:
          procMount: Unmasked

    # The chart has no value for `hostUsers`, so it is set by patch.
    # Kubernetes rejects procMount Unmasked without it.
    strategicMergePatches:
      - apiVersion: apps/v1
        kind: StatefulSet
        metadata:
          name: dsh
        spec:
          template:
            spec:
              hostUsers: false
