# Radiance (https://codeberg.org/StillDeadcode/radiance): inference server
# for AMD GPUs with hand-written RDNA4 kernels, on picon's GPU node
# srv-gpu01 (Radeon AI PRO R9700, 32 GB, shared with monster's desktop).
# Speaks the OpenAI, Anthropic and llama-server APIs; serves several models
# from one process and loads each one on the request that names it.
#
# First test of the GPU inference setup (2026-11-15); llama.cpp behind
# llama-swap is the fallback. Plain manifests via bedag/raw, see
# radiance.yaml.gotmpl. Needs apps/local-path-provisioner (model volume).
repositories:
  - name: bedag
    url: https://bedag.github.io/helm-charts/

releases:
  - name: radiance
    namespace: radiance
    chart: bedag/raw
    version: 2.0.2
    values:
      - radiance.yaml.gotmpl
