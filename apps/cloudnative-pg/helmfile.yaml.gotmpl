# CloudNativePG operator (https://cloudnative-pg.io). Cluster-wide: watches
# all namespaces for postgresql.cnpg.io resources (Cluster, Database, …).
#
# Ships its CRDs with the chart (crds.create: true). Database clusters
# themselves live with their consumers, e.g. apps/matrix-db.
repositories:
  - name: cnpg
    url: https://cloudnative-pg.github.io/charts

releases:
  - name: cloudnative-pg
    chart: cnpg/cloudnative-pg
    version: 0.29.1 # operator 1.30.1
    namespace: cnpg-system
    values:
      - resources:
          requests:
            cpu: 50m
            memory: 128Mi
          limits:
            memory: 512Mi
    # The clusters and poolers CRDs are too large for client-side apply:
    # the last-applied-configuration annotation would exceed 256 KiB. Let
    # Argo CD apply exactly these two server-side.
    strategicMergePatches:
    {{- range $crd := list "clusters" "poolers" }}
      - apiVersion: apiextensions.k8s.io/v1
        kind: CustomResourceDefinition
        metadata:
          name: {{ $crd }}.postgresql.cnpg.io
          annotations:
            argocd.argoproj.io/sync-options: ServerSideApply=true
    {{- end }}
