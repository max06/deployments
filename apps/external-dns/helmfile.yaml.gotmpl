repositories:
  - name: external-dns
    url: https://kubernetes-sigs.github.io/external-dns/

releases:
  - name: external-dns
    chart: external-dns/external-dns
    version: 1.21.1
    namespace: external-dns
    values:
      # - image:
      #     tag: v0.18.0
      - provider:
          name: pihole

        sources:
          - service
          - ingress
          - traefik-proxy
        registry: noop
        extraArgs:
          - "--pihole-api-version=6"
        env:
          # Short service name on purpose: it resolves through the pod's
          # search domains whatever the cluster domain is. picon's is
          # picon.hive.internal, so a hard-coded .svc.cluster.local never
          # resolved there and external-dns crash-looped.
          - name: EXTERNAL_DNS_PIHOLE_SERVER
            value: http://pihole-web.pihole.svc
          - name: EXTERNAL_DNS_PIHOLE_PASSWORD
            value: "{{ .Values.pihole_password }}"
        logLevel: debug
