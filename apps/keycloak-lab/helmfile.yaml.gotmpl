# Keycloak (dev mode) as a TEST identity provider for a lab Rancher:
# upstream for Rancher's keycloakoidc auth provider, while Rancher itself acts
# as OIDC provider for Argo CD. Realm "lab" with groups team-a/readers and one
# user each, imported on every start (dev mode, in-memory H2: nothing persists).
#
# Reachable on idp-lab.<primary_domain> via traefik's webinternal entrypoint
# (LAN ipAllowList, wildcard certificate). Secrets come from values.sops.yaml
# next to the deployment:
#   keycloak_admin_password, keycloak_rancher_client_secret,
#   keycloak_dora_password, keycloak_eric_password
# Remove the deployment when the lab test is done.

repositories:
  - name: bedag
    url: https://bedag.github.io/helm-charts/

releases:
  - name: keycloak-lab
    namespace: keycloak-lab
    chart: bedag/raw
    version: 2.0.2
    values:
      - resources.yaml.gotmpl
