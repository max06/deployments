repositories:
  - name: bedag
    url: https://bedag.github.io/helm-charts/

releases:
  - name: cilium-config
    namespace: kube-system
    chart: bedag/raw
    version: 2.0.2
    values:
      - resources:
          - apiVersion: "cilium.io/v2alpha1"
            kind: CiliumLoadBalancerIPPool
            metadata:
              name: "internal-pool"
            spec:
              blocks:
                - cidr: "192.168.30.240/28"
          - apiVersion: "cilium.io/v2alpha1"
            kind: CiliumL2AnnouncementPolicy
            metadata:
              name: "internal-policy"
            spec:
              # Only the Pis announce. The amd64 GPU node srv-gpu01 runs on
              # Flo's desktop; LAN DNS (Pi-hole) must not depend on it.
              nodeSelector:
                matchExpressions:
                  - key: kubernetes.io/arch
                    operator: In
                    values: ["arm64"]
              loadBalancerIPs: true
              externalIPs: true
