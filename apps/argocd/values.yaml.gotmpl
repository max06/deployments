configs:
  params:
    server.insecure: true
  cm:
    kustomize.buildOptions: --load-restrictor LoadRestrictionsNone --enable-helm

global:
  domain: "ci.{{  .Values.primary_domain  }}"

server:
  ingress:
    enabled: true

extraObjects:
  - apiVersion: v1
    kind: Secret
    metadata:
      name: argocd-age-secret-keys
      namespace: argocd
    type: Opaque
    stringData:
      keys.txt: |
        {{ .Values.ageSecretKey }}
{{- if hasKey .Values "extra" }}
  {{- range $k, $v := .Values.extra }}
  - {{ $v | toYaml | nindent 4 }}
  {{- end }}
{{- end }}
